# Mobile public configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:4801/api/v1
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API server configuration
PORT=4801
SBUD_API_DATA_MODE=fixture
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# BLIE provider configuration
# local keeps deterministic fixture-safe responses.
# openai-compatible sends BLIE's retrieval-grounded prompt to a Chat Completions-compatible endpoint.
SBUD_BLIE_PROVIDER=local
SBUD_BLIE_OPENAI_API_KEY=
SBUD_BLIE_OPENAI_BASE_URL=https://api.openai.com/v1
SBUD_BLIE_MODEL=
